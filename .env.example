# PoE2 Build Tracker - Environment Configuration
# Copy this file to .env and configure for your environment

# === REQUIRED ===

# Current PoE2 League
# Options: "Standard", "Dawn of the Hunt", "Legacy of the Vaal"
POE_LEAGUE=Dawn of the Hunt

# === DATABASE ===

# SQLite (default, good for development)
DATABASE_URL=sqlite:///./data/db/poe2_tracker.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/poe2_tracker

# === OPTIONAL ===

# Enable debug mode (shows detailed errors, enables auto-reload)
# WARNING: Never enable in production!
DEBUG=false

# Redis URL for caching (improves performance)
# If not set, in-memory caching is used
REDIS_URL=redis://localhost:6379

# CORS allowed origins (comma-separated)
# Add your frontend domain here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# === RATE LIMITING ===

# Trade API rate limiting
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_PERIOD=10
REQUEST_DELAY=2.0

# === CACHING ===

# Price cache TTL in seconds (5 minutes default)
PRICE_CACHE_TTL=300

# Currency cache TTL in seconds (1 hour default)
CURRENCY_CACHE_TTL=3600

# Price snapshot interval in seconds (6 hours default)
SNAPSHOT_INTERVAL=21600

# === USER AGENT ===

# User agent for API requests (include contact info)
USER_AGENT=PoE2BuildTracker/1.0 (your@email.com)
